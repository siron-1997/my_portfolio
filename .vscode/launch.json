{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Next.js: Dev mode",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev"],
            "port": 9229,
            "console": "integratedTerminal",
            "env": {
                "NODE_OPTIONS": "--inspect"
            },
            "cwd": "${workspaceFolder}/frontend"
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "Chrome: Frontend Debug",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Next.js Full Debug (Node + Chrome)",
            "configurations": ["Next.js: Dev mode", "Chrome: Frontend Debug"]
        }
    ]
}