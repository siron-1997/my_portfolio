# Next.js
# ローカル開発時のベースURL（フロントエンドのオリジン）
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
BASE_URL="http://localhost:3000"

# Resend
# お問い合わせメール送信者として表示される名前
MY_NAME="Your Name"
# 送信元・受信先として使用するメールアドレス（Resend で認証済みのドメインのアドレスを指定）
MY_EMAIL="your@email.com"
# Resend ダッシュボード → API Keys から発行（形式: re_xxxxx）
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# 送信元アドレス。ローカルテスト時は onboarding@resend.dev、本番は認証済みドメインを指定。
RESEND_FROM_EMAIL="onboarding@resend.dev"

# OpenWeather
# OpenWeatherMap ダッシュボード → API keys から発行（32文字の英数字）
OPEN_WEATHER_API_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Supabase
# Supabase ダッシュボード → Project Settings → API → Project URL
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
# Supabase ダッシュボード → Project Settings → API → service_role（非公開・サーバーサイド専用）
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxxxx.xxxxxxxx"
